# ===================================
# Frontend (codes/) .gitignore
# ===================================

# Dependencies
node_modules
**/node_modules

# Build Output
dist
dist-ssr
build
out
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.development
*.env
**/.env
**/.env.*

# Google Credentials (CRITICAL - NEVER COMMIT)
credentials.json
**/credentials.json
credentials-base64.txt
**/credentials-base64.txt
tcc-crm-backend-*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage
.nyc_output

# Cache
.cache
.parcel-cache
.vite
.eslintcache

# Temporary
*.tmp
*.temp
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
