# ==========================================
# TCC-CRM Backend Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values

# ==========================================
# Server Configuration
# ==========================================
PORT=3001
NODE_ENV=development

# ==========================================
# Google Sheets Configuration
# ==========================================
# The ID of your Google Sheet (from the URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ==========================================
# JWT Authentication
# ==========================================
# Generate a secure random string for production
# Example: openssl rand -hex 32
JWT_SECRET=your_very_long_and_secure_secret_key_change_this
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Security
# ==========================================
# Bcrypt hashing rounds (10-12 recommended)
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# CORS Configuration
# ==========================================
# Frontend URL (comma-separated for multiple origins)
CORS_ORIGIN=["http://localhost:5173", "http://localhost:8080"]

# ==========================================
# Cache Configuration
# ==========================================
# Time-to-live in seconds
CACHE_TTL=300
CACHE_CHECK_PERIOD=600

# ==========================================
# Meta WhatsApp Cloud API Configuration
# ==========================================
# Get these from https://developers.facebook.com/apps
# 1. Create Facebook App → Add WhatsApp Product
# 2. Get Phone Number ID from API Setup
# 3. Generate Permanent Access Token
WHATSAPP_META_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_META_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_META_BUSINESS_ACCOUNT_ID=your_business_account_id

# ==========================================
# SendGrid Email Configuration (Promotional)
# ==========================================
# Get API key from https://app.sendgrid.com/settings/api_keys
# Free tier: 100 emails/day
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_verified_sender@domain.com
SENDGRID_FROM_NAME=Triumphant Christian Centre (TCC)

# SendGrid Dynamic Templates (Optional)
SENDGRID_TEMPLATE_NEWSLETTER=d-your_newsletter_template_id
SENDGRID_TEMPLATE_EVENT=d-your_event_template_id
SENDGRID_TEMPLATE_ANNOUNCEMENT=d-your_announcement_template_id

# ==========================================
# Gmail SMTP Configuration (Automated Emails)
# ==========================================
# For Gmail, you need to create an app password
# https://myaccount.google.com/apppasswords
# Free tier: 500 emails/day
GMAIL_SMTP_USER=your_email@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_16_digit_app_password
GMAIL_SMTP_FROM_NAME=Triumphant Christian Centre (TCC)

# ==========================================
# BulkSMS Nigeria Configuration
# ==========================================
# Get API token from https://www.bulksmsnigeria.com
# Cost: ₦5.62-6.99 per SMS (much cheaper than Twilio)
BULKSMS_NIGERIA_API_TOKEN=your_bulksms_api_token
BULKSMS_NIGERIA_SENDER_NAME=Triumphant Christian Centre (TCC)
BULKSMS_NIGERIA_DND_ENABLED=true

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info
LOG_FORMAT=json
